# man apparmor.d
abi <abi/4.0>,
include <tunables/global>

/usr/sbin/netfoil-imds flags=(enforce) {
  # /etc/apparmor.d/abstractions/base
  include <abstractions/base>
  network inet tcp,

  /etc/netfoil/imds/** r,

  deny /** x,

  @{PROC}/@{pid}/cgroup r,
  @{PROC}/@{pid}/mountinfo r,
  /sys/fs/cgroup/netfoil_imds.slice/netfoil-imds.service/cpu.max r,

  # remove some of the defaults
  deny ptrace,
  deny unix,

  deny /usr/lib** mrwlkx,

  deny /etc/ld.** mrwlkx,
  deny /etc/gcrypt/** mrwlkx,
  deny /etc/crypto-policies/** mrwlkx,
  deny /etc/gnutls/** mrwlkx,

  deny /dev/full mrwlkx,
  deny /dev/zero mrwlkx,

  deny /home/** mrwlkx,
  deny /root/** mrwlkx,

  deny /opt** mrwlkx,
}
